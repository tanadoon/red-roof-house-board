# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจาก Supabase Project Settings -> API
# หากยังไม่ใส่ค่า ระบบจะทำงานในโหมด LocalStorage อัตโนมัติ (หรือตั้งค่าผ่านปุ่ม Cloud Settings บนหน้าเว็บได้เช่นกัน)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
